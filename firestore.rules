rules_version = '2';

// WanderAI / TravelLink AI — Firestore 安全規則（雙端合併版：網頁 + Android）
// 注意：這份是「網頁端 + Android 端」兩邊集合的合併結果，兩邊共用同一個 Firebase 專案、
// 同一份規則。任一端只部署自己那半份，都會把對方的集合變成預設拒絕（曾發生：Android 版
// 缺 invites/travel_sessions，導致網頁共編「Missing or insufficient permissions」）。
// 修改後務必兩端對齊、只從這份部署。
// 部署：Firebase Console → Firestore → 規則，或 `firebase deploy --only firestore:rules`
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 使用者個人資料：只能讀寫自己的 ──
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── 協作群組 / 行程（單人 + 多人共作共用同一集合）──
    // read/update 開放給所有登入者：Android 的 join-by-pin 與網頁的共編加入，
    // 都需要「非成員」先查得到文件並把自己寫進 members。
    match /micro_trips/{tripId} {
      function signedIn() {
        return request.auth != null;
      }
      function isOwner(data) {
        return signedIn() && (
          request.auth.uid == data.ownerUid
          || request.auth.token.email == data.ownerEmail
        );
      }
      function isEditor(data) {
        return isOwner(data) || (
          signedIn() && data.editorEmails != null && request.auth.token.email in data.editorEmails
        );
      }
      // 一般行程只能由本人建立；共編行程的 owner 欄位與成員清單也必須指向本人。
      allow create: if request.auth != null
        && (
          request.resource.data.ownerUid == request.auth.uid
          || request.resource.data.ownerEmail == request.auth.token.email
          || request.resource.data.userEmail == request.auth.token.email
        )
        && (!('memberEmails' in request.resource.data)
          || request.auth.token.email in request.resource.data.memberEmails);
      // 讀取：登入者皆可（join-by-pin／共編加入），或 guestReadable 的行程開放「未登入訪客」
      // 唯讀（網頁分享連結 ?sharedId=..&token=..&guest=1 是未登入開啟的——少了 guestReadable
      // 分支，所有分享連結都會 permission-denied，2026-07-08 已踩過）。
      allow read: if request.auth != null || resource.data.guestReadable == true;
      // 擁有者可調整協作設定；editor 只能更新行程內容，不能碰成員、邀請或擁有者欄位。
      allow update: if isOwner(resource.data)
        || (isEditor(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'customTitle', 'emoji', 'days', 'region', 'budget', 'people', 'wizardData',
          'stops', 'status', 'currentStopIndex', 'startedAt', 'updatedAt', 'lastEditedBy', 'lastEditedByName', 'titleVersion'
        ]))
        // 新成員只能透過仍有效的邀請碼加入，且只能增加自己的 email。
        || (signedIn()
          && request.resource.data.inviteCode == resource.data.inviteCode
          && exists(/databases/$(database)/documents/invites/$(resource.data.inviteCode))
          && get(/databases/$(database)/documents/invites/$(resource.data.inviteCode)).data.active == true
          && request.resource.data.memberEmails.size() == resource.data.memberEmails.size() + 1
          && request.resource.data.memberEmails.hasAll(resource.data.memberEmails)
          && request.auth.token.email in request.resource.data.memberEmails
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberEmails', 'members']));
      // 刪除：uid 擁有者（共編行程有 ownerUid）或 email 擁有者（網頁一般行程只有 userEmail，
      // 若只看 ownerUid 會把網頁端一般行程卡住刪不掉）。
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerUid
        || request.auth.token.email == resource.data.userEmail
        || request.auth.token.email == resource.data.ownerEmail
      );
      // 在線狀態子集合
      match /presence/{memberId} {
        allow read, write: if request.auth != null
          && request.auth.token.email in get(/databases/$(database)/documents/micro_trips/$(tripId)).data.memberEmails;
      }

      // 回饋獨立成子集合，避免 editor 為其他成員覆寫 feedback map。
      match /member_prefs/{memberId} {
        allow read: if signedIn()
          && request.auth.token.email in get(/databases/$(database)/documents/micro_trips/$(tripId)).data.memberEmails;
        allow create: if signedIn()
          && request.auth.token.email in get(/databases/$(database)/documents/micro_trips/$(tripId)).data.memberEmails
          && request.resource.data.email == request.auth.token.email;
        allow update: if signedIn()
          && request.auth.token.email in get(/databases/$(database)/documents/micro_trips/$(tripId)).data.memberEmails
          && resource.data.email == request.auth.token.email
          && request.resource.data.email == request.auth.token.email;
        allow delete: if signedIn() && resource.data.email == request.auth.token.email;
      }

      match /feedback/{feedbackId} {
        allow read: if request.auth != null
          && (
            request.auth.token.email == resource.data.email
            || request.auth.token.email == get(/databases/$(database)/documents/micro_trips/$(tripId)).data.ownerEmail
            || request.auth.token.email in get(/databases/$(database)/documents/micro_trips/$(tripId)).data.memberEmails
          );
        allow create, update: if request.auth != null
          && request.resource.data.email == request.auth.token.email;
        allow delete: if request.auth != null
          && resource.data.email == request.auth.token.email;
      }
    }

    // ── 景點資料（由 crawler / Admin SDK 維護，前端唯讀）──
    match /scenic_points/{docId} {
      allow read: if request.auth != null;
    }

    // ── 營業時間快取（由受控後端維護，前端唯讀）──
    match /hours_cache/{docId} {
      allow read: if request.auth != null;
    }

    // ── 舊版獨立回饋文件：只能由文件內 email 對應的使用者建立/修改 ──
    match /feedback/{docId} {
      allow read: if request.auth != null && resource.data.email == request.auth.token.email;
      allow create, update: if request.auth != null
        && request.resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null && resource.data.email == request.auth.token.email;
    }

    // ── 由 seeding script (admin SDK) 維護，App 端唯讀 ──
    match /poi_knowledge/{docId} {
      allow read: if request.auth != null;
    }
    match /custom_pois/{docId} {
      allow read: if request.auth != null;
    }

    // ── 邀請碼 → 行程對應（網頁端共編「建立/加入」必需，缺這段會 permission-denied）──
    match /invites/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/micro_trips/$(request.resource.data.tripId))
        && get(/databases/$(database)/documents/micro_trips/$(request.resource.data.tripId)).data.ownerEmail == request.auth.token.email;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/micro_trips/$(resource.data.tripId)).data.ownerEmail == request.auth.token.email;
      allow delete: if false;
    }

    // ── 行程操作事件記錄（logTripEvent，只新增不可讀改；封閉測試分析用）──
    match /travel_sessions/{sessionId} {
      allow read, write: if false;
      match /events/{eventId} {
        allow create: if request.auth != null;
        allow read, update, delete: if false;
      }
    }
  }
}
